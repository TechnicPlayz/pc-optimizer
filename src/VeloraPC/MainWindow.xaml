<Window x:Class="VeloraPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Velora PC" Width="1140" Height="780" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,22,14,16">
                <StackPanel x:Name="BrandPanel" DockPanel.Dock="Top"/>
                <StackPanel x:Name="BottomPanel" DockPanel.Dock="Bottom"/>
                <StackPanel x:Name="NavPanel" Margin="0,24,0,0"/>
            </DockPanel>
        </Border>

        <ContentPresenter x:Name="PageHost" Grid.Column="1"/>
        <StackPanel x:Name="ToastHost" Grid.Column="1" VerticalAlignment="Bottom"
                    HorizontalAlignment="Right" Margin="0,0,24,24"/>

        <Grid x:Name="Overlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#99000000"/>
        <Grid x:Name="OnboardHost" Grid.ColumnSpan="2" Visibility="Collapsed"
              Background="{DynamicResource BgBrush}"/>
    </Grid>
</Window>
